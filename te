"""
Forex backtest: Moving Average Crossover
ใช้เพื่อการเรียนรู้ ไม่ใช่คำแนะนำการลงทุน
 
วิธีใช้:
    pip install pandas numpy
    python forex_backtest.py                    # ใช้ข้อมูลสุ่มจำลอง
    python forex_backtest.py EURUSD_H1.csv      # ใช้ไฟล์ CSV ของคุณ
 
CSV ต้องมีคอลัมน์ 'close' (และควรมี 'time' หรือ 'date')
"""
import sys
import numpy as np
import pandas as pd
 
# ---------- ตั้งค่า ----------
FAST = 20             # เส้น MA เร็ว
SLOW = 50             # เส้น MA ช้า
COST_PIPS = 1.5       # ต้นทุนต่อการเปลี่ยนสถานะ (spread + slippage) หน่วย pip
PIP = 0.0001          # 1 pip ของคู่เงินส่วนใหญ่ (JPY ใช้ 0.01)
BARS_PER_YEAR = 24 * 252   # สำหรับข้อมูลรายชั่วโมง (ปรับตาม timeframe)
START_BALANCE = 10_000
 
 
def load_data(path=None):
    if path:
        df = pd.read_csv(path)
        df.columns = [c.lower() for c in df.columns]
        return df[["close"]].dropna().reset_index(drop=True)
    # ข้อมูลสุ่มจำลอง (random walk) ไม่มี edge จริง
    rng = np.random.default_rng(42)
    steps = rng.normal(0, 0.0004, 20_000)
    return pd.DataFrame({"close": 1.10 + np.cumsum(steps)})
 
 
def backtest(df):
    df = df.copy()
    df["fast"] = df["close"].rolling(FAST).mean()
    df["slow"] = df["close"].rolling(SLOW).mean()
 
    # +1 = ซื้อ, -1 = ขาย, 0 = ยังไม่มีสัญญาณ
    df["signal"] = np.where(df["fast"] > df["slow"], 1, -1)
    df.loc[df["slow"].isna(), "signal"] = 0
 
    # เข้าสถานะที่แท่งถัดไป เพื่อไม่ให้ "แอบรู้อนาคต" (look-ahead bias)
    df["position"] = df["signal"].shift(1).fillna(0)
 
    df["ret"] = df["close"].pct_change().fillna(0)
    gross = df["position"] * df["ret"]
 
    # หักต้นทุนทุกครั้งที่เปลี่ยนสถานะ
    trades = df["position"].diff().abs().fillna(0)
    cost = trades * (COST_PIPS * PIP) / df["close"]
    df["strategy_ret"] = gross - cost
 
    df["equity"] = START_BALANCE * (1 + df["strategy_ret"]).cumprod()
    df["buy_hold"] = START_BALANCE * (1 + df["ret"]).cumprod()
    return df
 
 
def report(df):
    equity = df["equity"]
    total_ret = equity.iloc[-1] / START_BALANCE - 1
    drawdown = equity / equity.cummax() - 1
    sr = df["strategy_ret"]
    sharpe = (sr.mean() / sr.std() * np.sqrt(BARS_PER_YEAR)) if sr.std() > 0 else 0
 
    # แยกรอบการเทรดแต่ละรอบ เพื่อคำนวณ win rate
    trade_id = (df["position"].diff().abs() > 0).cumsum()
    per_trade = df[df["position"] != 0].groupby(trade_id)["strategy_ret"].sum()
    win_rate = (per_trade > 0).mean() if len(per_trade) else 0
 
    print("=" * 40)
    print(f"ผลตอบแทนกลยุทธ์     : {total_ret:+.2%}")
    print(f"ผลตอบแทน buy & hold : {df['buy_hold'].iloc[-1] / START_BALANCE - 1:+.2%}")
    print(f"Max drawdown        : {drawdown.min():.2%}")
    print(f"Sharpe ratio        : {sharpe:.2f}")
    print(f"จำนวนรอบการเทรด    : {len(per_trade)}")
    print(f"Win rate            : {win_rate:.1%}")
    print(f"เงินสุดท้าย         : {equity.iloc[-1]:,.2f} (เริ่ม {START_BALANCE:,})")
    print("=" * 40)
 
 
if __name__ == "__main__":
    path = sys.argv[1] if len(sys.argv) > 1 else None
    data = load_data(path)
    result = backtest(data)
    report(result)
